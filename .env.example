# Register this callback in your Spotify developer dashboard:
# http://127.0.0.1:3000/auth/callback
SPOTIFY_CLIENT_ID=
PORT=3000
# Optional: defaults to http://127.0.0.1:PORT (local loopback only).
# APP_ORIGIN=http://127.0.0.1:3000
# Data and the generated encryption key stay in this ignored directory.
# DATA_DIR=.data
