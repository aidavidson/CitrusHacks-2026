{
  "name": "sortify",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.js",
    "dev": "node --env-file-if-exists=.env backend/server.js --dev",
    "build": "vite build",
    "pretest": "npm run build",
    "pretest:browser": "npm run build",
    "test": "node --test backend/*.test.js",
    "test:browser": "node backend/browser-check.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "vite": "^8.3.4"
  }
}
